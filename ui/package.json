{
  "name": "chatgpt-harness-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "runtime:dev": "cargo build --manifest-path ../Cargo.toml -p chatgpt-harness-runtime",
    "runtime:release": "cargo build --manifest-path ../Cargo.toml -p chatgpt-harness-runtime --release",
    "tauri:dev": "npm run dev:preflight && npm run runtime:dev && tauri dev",
    "tauri:build": "npm run bundle:windows",
    "distribution:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stage-distribution.ps1",
    "tauri": "tauri",
    "dev:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/free-dev-port.ps1",
    "bundle:windows": "npm run distribution:stage && tauri build --bundles nsis && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-nsis-bundle.ps1",
    "portable:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-portable-icons.ps1",
    "portable:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "i18next": "^26.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
