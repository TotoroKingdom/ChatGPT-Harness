{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT-Harness",
  "identifier": "com.chatgpt.harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatGPT-Harness",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../target-exe/distribution/runtime": "runtime",
      "../../target-exe/distribution/tunnel": "tunnel",
      "../../target-exe/distribution/distribution.json": "distribution.json"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ChatGPT-Harness"
      }
    }
  }
}
