{
  "$comment": "GENERATED FILE — DO NOT EDIT",
  "$defs": {
    "BashConfig": {
      "additionalProperties": false,
      "properties": {
        "autoDetect": {
          "default": true,
          "type": "boolean"
        },
        "executablePath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ClientInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "version"
      ],
      "type": "object"
    },
    "DecimalU64": {
      "description": "A non-negative 64-bit integer represented as a decimal string on the JSON wire.\n\nKeeping revisions and cursors as strings avoids JSON number precision loss and\nmakes the representation identical across Tauri and future JSONL transports.",
      "type": "string"
    },
    "EvidenceStoreLaunchConfig": {
      "additionalProperties": false,
      "description": "Host-only evidence persistence settings. The database path never appears\nin History DTOs, Activity, Tool arguments, or durable event rows.",
      "properties": {
        "databasePath": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "maxStorageMiB": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retentionDays": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "databasePath",
        "retentionDays",
        "maxStorageMiB"
      ],
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "toolDefaults": {
          "$ref": "#/$defs/ToolPolicyDefaults",
          "default": {
            "bash": "ask",
            "edit": "allow",
            "glob": "allow",
            "grep": "allow",
            "readFile": "allow",
            "write": "allow"
          }
        },
        "userRules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UserPolicyRuleConfig"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PolicyDecision": {
      "enum": [
        "deny",
        "ask",
        "allow"
      ],
      "type": "string"
    },
    "PolicyMatcherConfig": {
      "description": "Persisted tagged matcher.  The internally tagged representation keeps the\nM3 wire shape (`{\"type\":\"tool\",\"tool\":\"write\"}`) while adding the\nM5 command matcher (`{\"type\":\"bash_command\",...}`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string"
            },
            "type": {
              "const": "tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "argvPrefix": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "executable": {
              "type": "string"
            },
            "type": {
              "const": "bash_command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "executable",
            "argvPrefix"
          ],
          "type": "object"
        }
      ]
    },
    "RuntimeConfigSnapshot": {
      "description": "The non-secret, immutable-at-startup configuration consumed by a Runtime.",
      "properties": {
        "bash": {
          "$ref": "#/$defs/BashConfig",
          "default": {
            "autoDetect": true
          }
        },
        "configRevision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "policies": {
          "$ref": "#/$defs/PolicyConfig",
          "default": {
            "toolDefaults": {
              "bash": "ask",
              "edit": "allow",
              "glob": "allow",
              "grep": "allow",
              "readFile": "allow",
              "write": "allow"
            },
            "userRules": []
          }
        },
        "runtimeLimits": {
          "$ref": "#/$defs/RuntimeLimits"
        },
        "search": {
          "$ref": "#/$defs/SearchConfig",
          "default": {
            "globTimeoutSeconds": 30,
            "grepTimeoutSeconds": 30
          }
        },
        "security": {
          "$ref": "#/$defs/SecurityConfig"
        },
        "tools": {
          "$ref": "#/$defs/ToolConfig"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceConfig"
        }
      },
      "required": [
        "configRevision",
        "workspace",
        "security",
        "runtimeLimits",
        "tools"
      ],
      "type": "object"
    },
    "RuntimeHostContext": {
      "additionalProperties": false,
      "properties": {
        "evidenceStore": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStoreLaunchConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "hostSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "supervisorGenerationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeLimits": {
      "properties": {
        "maxActivityEvents": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxConcurrentRequests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxReadBytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maxConcurrentRequests",
        "maxActivityEvents",
        "maxReadBytes"
      ],
      "type": "object"
    },
    "SearchConfig": {
      "additionalProperties": false,
      "description": "Independent wall-clock budgets for the two search tools.",
      "properties": {
        "globTimeoutSeconds": {
          "default": 30,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "grepTimeoutSeconds": {
          "default": 30,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "SecurityConfig": {
      "properties": {
        "developerTestMode": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/SecurityMode"
        }
      },
      "required": [
        "mode",
        "developerTestMode"
      ],
      "type": "object"
    },
    "SecurityMode": {
      "enum": [
        "normal",
        "developer_test"
      ],
      "type": "string"
    },
    "ToolConfig": {
      "additionalProperties": false,
      "properties": {
        "bash": {
          "$ref": "#/$defs/ToolEnabledConfig"
        },
        "edit": {
          "$ref": "#/$defs/ToolEnabledConfig"
        },
        "glob": {
          "$ref": "#/$defs/ToolEnabledConfig"
        },
        "grep": {
          "$ref": "#/$defs/ToolEnabledConfig",
          "default": {
            "enabled": false
          }
        },
        "readFile": {
          "$ref": "#/$defs/ToolEnabledConfig"
        },
        "write": {
          "$ref": "#/$defs/ToolEnabledConfig"
        }
      },
      "required": [
        "readFile",
        "glob",
        "write",
        "edit",
        "bash"
      ],
      "type": "object"
    },
    "ToolEnabledConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "ToolPolicyDefaults": {
      "additionalProperties": false,
      "properties": {
        "bash": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "edit": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "glob": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "grep": {
          "$ref": "#/$defs/PolicyDecision",
          "default": "allow"
        },
        "readFile": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "write": {
          "$ref": "#/$defs/PolicyDecision"
        }
      },
      "required": [
        "readFile",
        "glob",
        "write",
        "edit",
        "bash"
      ],
      "type": "object"
    },
    "UserPolicyRuleConfig": {
      "additionalProperties": false,
      "description": "Only user-owned fields are persisted. Runtime projections add `source` and\n`editable`, so callers cannot manufacture a system rule in AppConfig.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "matcher": {
          "$ref": "#/$defs/PolicyMatcherConfig"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "decision",
        "matcher",
        "reason"
      ],
      "type": "object"
    },
    "WorkspaceConfig": {
      "properties": {
        "rootPath": {
          "type": "string"
        }
      },
      "required": [
        "rootPath"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "capabilities": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    },
    "clientInfo": {
      "$ref": "#/$defs/ClientInfo"
    },
    "hostContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeHostContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "protocolVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "runtimeConfig": {
      "$ref": "#/$defs/RuntimeConfigSnapshot"
    }
  },
  "required": [
    "clientInfo",
    "protocolVersion",
    "capabilities",
    "runtimeConfig"
  ],
  "title": "InitializeParams",
  "type": "object"
}
