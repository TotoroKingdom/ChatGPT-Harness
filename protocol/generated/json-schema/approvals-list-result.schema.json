{
  "$comment": "GENERATED FILE — DO NOT EDIT",
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "allow_once",
        "allow_for_session",
        "deny"
      ],
      "type": "string"
    },
    "ApprovalRequest": {
      "properties": {
        "allowForSessionEligible": {
          "description": "`None` is the legacy/non-Bash value.  Bash always supplies `Some` so\nunclassified commands can explicitly disable session grants.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowForSessionUnavailableReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/BashSessionGrantUnavailableReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "bashDetails": {
          "anyOf": [
            {
              "$ref": "#/$defs/BashApprovalDetails"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional M5 Bash projection.  Omitted for existing file-tool approval\nrecords so older consumers retain their current wire shape."
        },
        "createdAt": {
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "type": "string"
        },
        "generationId": {
          "type": "string"
        },
        "matchedRuleIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policyReason": {
          "$ref": "#/$defs/PolicyReason"
        },
        "requestId": {
          "type": "string"
        },
        "resolvedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "riskLevel": {
          "$ref": "#/$defs/RiskLevel"
        },
        "runtimeId": {
          "type": "string"
        },
        "sanitizedArguments": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "scopeSummary": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "runtimeId",
        "generationId",
        "tool",
        "sanitizedArguments",
        "scopeSummary",
        "matchedRuleIds",
        "policyReason",
        "riskLevel",
        "createdAt",
        "expiresAt",
        "status"
      ],
      "type": "object"
    },
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "cancelled"
      ],
      "type": "string"
    },
    "BashApprovalDetails": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/BashClassification"
        },
        "commandPreview": {
          "description": "Bounded, shell-display-safe preview; it is never the raw command.",
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/BashWorkingDirectory"
        },
        "destructive": {
          "default": false,
          "description": "True when the analyzer matched a destructive operation.",
          "type": "boolean"
        },
        "destructiveReasons": {
          "description": "Sorted, deduplicated destructive reasons; omitted when empty.",
          "items": {
            "$ref": "#/$defs/BashDestructiveReason"
          },
          "type": "array"
        },
        "normalizedSegments": {
          "items": {
            "$ref": "#/$defs/BashApprovalSegment"
          },
          "type": "array"
        },
        "previewRedacted": {
          "type": "boolean"
        },
        "previewTruncated": {
          "type": "boolean"
        },
        "riskFlags": {
          "items": {
            "$ref": "#/$defs/BashRiskFlag"
          },
          "type": "array"
        }
      },
      "required": [
        "commandPreview",
        "classification",
        "normalizedSegments",
        "riskFlags",
        "cwd",
        "previewRedacted",
        "previewTruncated"
      ],
      "type": "object"
    },
    "BashApprovalSegment": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "description": "Logical argv suitable for display only.  A value of `true` in\n`argv_redacted` means this vector cannot be used to create an exact\nBashCommand matcher draft.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "argvRedacted": {
          "type": "boolean"
        },
        "executable": {
          "description": "Sanitized normalized executable identity.  This is never a raw shell\nsource fragment or a canonical filesystem path.",
          "type": "string"
        }
      },
      "required": [
        "executable",
        "argv",
        "argvRedacted"
      ],
      "type": "object"
    },
    "BashClassification": {
      "description": "Runtime-owned, display-safe Bash approval evidence.  This projection is\nintentionally separate from the internal normalized command scope used by\nSessionGrant matching: the latter may contain sensitive literal argv and\nnever crosses the protocol boundary.",
      "enum": [
        "classified",
        "unclassified_high_risk"
      ],
      "type": "string"
    },
    "BashDestructiveReason": {
      "enum": [
        "delete",
        "overwrite",
        "disk",
        "repository"
      ],
      "type": "string"
    },
    "BashRiskFlag": {
      "enum": [
        "command_substitution",
        "backticks",
        "eval",
        "nested_shell",
        "interpreter_inline_code",
        "redirection",
        "dynamic_expansion",
        "malformed_quoting",
        "unsupported_grammar"
      ],
      "type": "string"
    },
    "BashSessionGrantUnavailableReason": {
      "enum": [
        "unclassified_high_risk"
      ],
      "type": "string"
    },
    "BashWorkingDirectory": {
      "enum": [
        "active_workspace"
      ],
      "type": "string"
    },
    "PolicyReason": {
      "description": "Reasons are typed because policy evidence is consumed by Runtime, control\nreads, activity, and the UI. They are not display-only log strings.",
      "enum": [
        "system_guardrail",
        "matched_user_rules",
        "tool_default",
        "analyzer_risk_floor",
        "invalid_policy_snapshot",
        "invalid_context",
        "unsupported_capability",
        "tool_disabled"
      ],
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ApprovalRequest"
      },
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ApprovalsListResult",
  "type": "object"
}
